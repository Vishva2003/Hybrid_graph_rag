# ---------- ingestion ----------
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MIN_CHUNK_LEN=30

# ---------- embeddings ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# ---------- Qdrant ----------
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hybrid_graphrag

# ---------- retrieval ----------
BM25_TOP_K=10
VECTOR_TOP_K=10
RRF_K=60
FINAL_TOP_K=5

# ---------- LLM (OpenRouter) ----------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ---------- graph ----------
GRAPH_MODEL=meta-llama/llama-3.1-8b-instruct:free
GRAPH_MAX_NODES_PER_RUN=50

# ---------- Neo4j (optional) ----------
NETWORKX_URI=bolt://localhost:7687
NETWORKX_USER=neo4j
NETWORKX_PASSWORD=yourpassword

# ---------- evaluation ----------
RAGAS_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx